# Supabase persistence. When both values are present, API routes use Supabase;
# otherwise they fall back to the local in-memory mock store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chat-completions compatible LLM endpoint. When disabled or incomplete,
# lead triage falls back to the deterministic rules mock.
EASTAURA_LLM_ENABLED=false
EASTAURA_LLM_API_URL=
EASTAURA_LLM_API_KEY=
EASTAURA_LLM_MODEL=

# Optional admin guard for internal CRM APIs. When empty, local development is open.
EASTAURA_ADMIN_API_TOKEN=
# Keep false in deployment. Set true only for local `next start` smoke tests without a token.
EASTAURA_ALLOW_OPEN_ADMIN_API=false

# Optional notification delivery. In-app notifications are always recorded.
RESEND_API_KEY=
EASTAURA_NOTIFICATION_FROM=
EASTAURA_NOTIFICATION_TO=
FEISHU_WEBHOOK_URL=
FEISHU_BOT_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# Optional public intake protection. Empty means local/mock mode.
EASTAURA_INTAKE_RATE_LIMIT_WINDOW_MS=600000
EASTAURA_INTAKE_RATE_LIMIT_MAX=10
EASTAURA_INTAKE_DUPLICATE_WINDOW_MS=600000
TURNSTILE_SECRET_KEY=
